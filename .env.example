# Required when ingestion and query generation are enabled.
GOOGLE_API_KEY=

# Model selection
CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072

# Retrieval and graph limits
RETRIEVAL_TOP_K=5
MAX_QUERY_REWRITES=2
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_ATTEMPTS=3
RETRY_INITIAL_INTERVAL_SECONDS=0.5
RETRY_MAX_INTERVAL_SECONDS=4
GRADING_CONCURRENCY=3
MAX_QUESTION_LENGTH=2000
MAX_CONTEXT_CHARACTERS=30000

# Ingestion limits
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=80
MAX_UPLOAD_BYTES=5242880
MAX_FETCH_BYTES=5242880
FETCH_TIMEOUT_SECONDS=15
MAX_FETCH_REDIRECTS=3

# Local persistence
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=technical_docs
APPLICATION_DB_PATH=data/application.sqlite3
CHECKPOINT_DB_PATH=data/checkpoints.sqlite3
CHECKPOINT_RETENTION_DAYS=7
LOG_LEVEL=INFO
RUN_LIVE_TESTS=0
