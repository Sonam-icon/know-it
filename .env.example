# Required when ingestion and query generation are enabled.
# Supply one key or multiple comma-separated keys for round-robin selection.
GOOGLE_API_KEY=

# Model selection
CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072

# Retrieval and graph limits
RETRIEVAL_TOP_K=5
MAX_QUERY_REWRITES=2
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_ATTEMPTS=3
MAX_QUESTION_LENGTH=2000
MAX_CONTEXT_CHARACTERS=30000
MAX_ANSWER_REVISIONS=1

# Bounded conversation memory
MEMORY_TURN_LIMIT=3
MEMORY_MAX_CHARACTERS=6000

# Optional Tavily fallback (disabled until credentials are configured)
WEB_FALLBACK_ENABLED=false
TAVILY_API_KEY=
WEB_SEARCH_TOP_K=3
WEB_SEARCH_DOMAINS=fastapi.tiangolo.com
WEB_SEARCH_MAX_RESPONSE_BYTES=1000000
WEB_SEARCH_MAX_EXCERPT_CHARACTERS=4000

# Ingestion limits
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=80
MAX_UPLOAD_BYTES=5242880
MAX_FETCH_BYTES=5242880
FETCH_TIMEOUT_SECONDS=15
MAX_FETCH_REDIRECTS=3

# Local persistence
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=technical_docs
APPLICATION_DB_PATH=data/application.sqlite3
LOG_LEVEL=INFO
RUN_LIVE_TESTS=0
